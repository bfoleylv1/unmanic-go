[Unit]
Description=Unmanic-Go Transcoder Web UI
After=network.target

[Service]
Type=simple
User=bfoleylv
WorkingDirectory=/home/bfoleylv/unmanic-go
ExecStart=/home/bfoleylv/unmanic-go/unmanic-go
Restart=on-failure
RestartSec=5
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

[Install]
WantedBy=multi-user.target
